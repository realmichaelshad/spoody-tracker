# ── Branding ────────────────────────────────────────────────────────────────
# Rename the whole site without touching code.
VITE_SITE_NAME="WEBHEAD TRACKER"
VITE_TAGLINE="INTERACT WITH THE MAP TO VIEW SIGHTINGS ALL OVER THE WORLD."

# ── Map tiles ───────────────────────────────────────────────────────────────
# Default: OpenFreeMap public instance (free, keyless, no request limits).
# Alternatives documented in README (self-hosted PMTiles etc.).
#VITE_TILES_URL="https://tiles.openfreemap.org/planet"

# ── Supabase backend ────────────────────────────────────────────────────────
# Leave BOTH unset to run in demo mode (no backend needed — local data only).
#VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
#VITE_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# ── Optional anti-bot (Cloudflare Turnstile) ────────────────────────────────
#VITE_TURNSTILE_SITE_KEY="0x..."

# ── Edge function secrets (set via `supabase secrets set`, NOT in this file) ─
# IP_SALT=<long random string>
# TURNSTILE_SECRET=<secret key>
# ADMIN_TOKEN=<long random string>
# NSFW_SERVER_CHECK=on
