{
  "name": "webhead-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source retro pixel-art community sightings map — report sightings anywhere on Earth, watch them appear live for everyone.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run sprites && tsc --noEmit && vite build",
    "preview": "vite preview",
    "sprites": "tsx scripts/build-sprites.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/bitcount-prop-single": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/jersey-25": "^5.3.0",
    "@preact/signals": "^2.0.0",
    "@supabase/supabase-js": "^2.52.0",
    "@tensorflow/tfjs": "^4.22.0",
    "maplibre-gl": "^6.1.0",
    "nsfwjs": "^4.3.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
