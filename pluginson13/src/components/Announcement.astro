---
/* The optional strip set in src/data/business.ts → announcement. */
import { business } from '../data/business';
import Icon from './Icon.astro';

const { text, href } = business.announcement;
---

{
  text && (
    <div class="announcement">
      <div class="container">
        {href ? (
          <a href={href}>
            <Icon name="sparkle" size={18} />
            <span>{text}</span>
            <Icon name="arrow" size={16} />
          </a>
        ) : (
          <p>
            <Icon name="sparkle" size={18} />
            <span>{text}</span>
          </p>
        )}
      </div>
    </div>
  )
}

<style>
  .announcement {
    background: var(--copper-600);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 560;
    text-align: center;
  }

  .announcement a,
  .announcement p {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 0;
    color: inherit;
    text-decoration: none;
  }

  .announcement a:hover span {
    text-decoration: underline;
  }
</style>
