---
import { business } from '../data/business';
---

<ul class="brands" aria-label="Brands we carry">
  {
    business.brands.map((brand, i) => (
      <li class="reveal" style={`--delay:${(i % 5) * 50}ms`}>
        <span>{brand}</span>
      </li>
    ))
  }
  <li class="brands__more reveal">
    <span>+ many more — just ask</span>
  </li>
</ul>

<style>
  .brands {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 959px) {
    .brands {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 559px) {
    .brands {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .brands li {
    display: grid;
    place-items: center;
    min-height: 92px;
    padding: 16px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    text-align: center;
  }

  .brands span {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 640;
    letter-spacing: -0.02em;
    color: var(--ink-900);
  }

  .brands .brands__more {
    background: transparent;
    border-style: dashed;
    border-color: var(--line-2);
  }

  .brands .brands__more span {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--text-3);
  }
</style>
