---
import { business, mainStore, stores, telHref } from '../data/business';
import { departments, primaryNav } from '../data/nav';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import StatusPill from './StatusPill.astro';
import DeptArt from './art/DeptArt.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const inShop = departments.some((d) => isCurrent(d.href));
---

<aside class="utility no-print" aria-label="Store hours and phone numbers">
  <div class="container utility__inner">
    <p class="utility__note">
      <span class="he" lang="he" title="B'siyata d'Shmaya">בס״ד</span>
      <span>Family owned · Delivering to {business.serviceArea.slice(0, -1).join(', ')} &amp; {business.serviceArea.at(-1)}</span>
    </p>
    <ul class="utility__stores" aria-label="Our stores">
      {
        stores.map((store) => (
          <li>
            <a class="utility__store" href={`/locations/${store.id}/`}>
              {store.name}
            </a>
            <StatusPill store={store.id} detail={false} class="status--mini" />
            <a class="utility__phone" href={telHref(store)}>
              {store.phone}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<header class="site-header" data-header>
  <div class="container masthead">
    <a href="/" class="masthead__logo" aria-label={`${business.name} — home`}>
      <Logo />
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        <li class="nav__item" data-shop>
          <button
            class="nav__link nav__trigger"
            type="button"
            aria-expanded="false"
            aria-controls="shop-menu"
            aria-current={inShop ? 'true' : undefined}
          >
            Shop
            <Icon name="chevron" size={16} strokeWidth={2} />
          </button>
          <div class="mega" id="shop-menu" hidden>
            <div class="mega__grid">
              {
                departments.map((dept) => (
                  <a class="mega__card" href={dept.href} aria-current={isCurrent(dept.href) ? 'page' : undefined}>
                    <span class="mega__art">
                      <DeptArt kind={dept.art} />
                    </span>
                    <span class="mega__title">{dept.title}</span>
                    <span class="mega__blurb">{dept.blurb}</span>
                  </a>
                ))
              }
            </div>
            <aside class="mega__aside">
              <p class="mega__kicker">Looking for one model?</p>
              <p>Send us the model number — we'll check the price and whether it's in stock.</p>
              <a class="link-arrow" href="/contact/">
                Ask for a price <Icon name="arrow" />
              </a>
            </aside>
          </div>
        </li>
        {
          primaryNav.map((link) => (
            <li class="nav__item">
              <a class="nav__link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="masthead__actions">
      <a class="btn btn--ghost btn--sm masthead__ask" href="/contact/">Ask a price</a>
      <a class="btn btn--primary btn--sm masthead__call" href={telHref(mainStore)}>
        <Icon name="phone" />
        <span>{mainStore.phone}</span>
      </a>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>
</header>

<dialog class="drawer" id="mobile-menu" aria-label="Menu">
  <div class="drawer__top">
    <a href="/" aria-label={`${business.name} — home`}><Logo /></a>
    <button class="drawer__close" type="button" aria-label="Close menu" data-menu-close>
      <Icon name="close" size={26} />
    </button>
  </div>

  <nav class="drawer__body" aria-label="Menu">
    <p class="drawer__label">Shop</p>
    <ul class="drawer__depts">
      {
        departments.map((dept) => (
          <li>
            <a href={dept.href} aria-current={isCurrent(dept.href) ? 'page' : undefined}>
              <span class="drawer__art">
                <DeptArt kind={dept.art} />
              </span>
              <span>{dept.title}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="drawer__links">
      {
        primaryNav.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
              <Icon name="arrow" size={20} />
            </a>
          </li>
        ))
      }
      <li>
        <a href="/contact/" aria-current={isCurrent('/contact/') ? 'page' : undefined}>
          Contact &amp; price check
          <Icon name="arrow" size={20} />
        </a>
      </li>
    </ul>

    <p class="drawer__label">Our stores</p>
    <ul class="drawer__stores">
      {
        stores.map((store) => (
          <li class="drawer__store">
            <div>
              <a class="drawer__store-name" href={`/locations/${store.id}/`}>
                {store.name} <span class="muted">· {store.street}</span>
              </a>
              <StatusPill store={store.id} />
            </div>
            <div class="drawer__store-actions">
              <a class="btn btn--primary btn--sm" href={telHref(store)}>
                <Icon name="phone" /> Call
              </a>
              <a class="btn btn--ghost btn--sm" href={store.mapsUrl} target="_blank" rel="noopener">
                <Icon name="directions" /> Directions
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="drawer__social">
      <a href={business.instagram.url} target="_blank" rel="noopener">
        <Icon name="instagram" /> {business.instagram.handle}
      </a>
      <a href={`mailto:${business.email}`}>
        <Icon name="mail" /> Email us
      </a>
    </p>
  </nav>
</dialog>

<style>
  /* ---------- Utility bar ---------- */
  .utility {
    background: var(--ink-900);
    color: #c4cfdc;
    font-size: 0.84rem;
  }

  .utility__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 42px;
  }

  .utility__note {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .utility__note > span:last-child {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .utility .he {
    color: #fff;
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .utility__stores {
    display: flex;
    gap: 22px;
    padding: 0;
    list-style: none;
  }

  .utility__stores li {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .utility__stores li + li {
    padding-left: 22px;
    border-left: 1px solid rgb(255 255 255 / 12%);
  }

  .utility__store {
    color: #fff;
    font-weight: 620;
    text-decoration: none;
  }

  .utility__phone {
    color: #c4cfdc;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .utility a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .utility :global(.status--mini) {
    min-height: 22px;
    padding: 0.15em 0.6em 0.15em 0.5em;
    font-size: 0.76rem;
    --status-bg: rgb(255 255 255 / 8%);
    --status-fg: #d7dee8;
  }

  .utility :global(.status--mini[data-state='open']) {
    --status-fg: #7fe0ae;
    --status-bg: rgb(127 224 174 / 12%);
  }

  .utility :global(.status--mini[data-state='closing']),
  .utility :global(.status--mini[data-state='opening']) {
    --status-fg: #ffd08a;
    --status-bg: rgb(255 208 138 / 12%);
  }

  .utility :global(.status--mini[data-state='closed']) {
    --status-fg: #ffb4a8;
    --status-bg: rgb(255 180 168 / 12%);
  }

  @media (max-width: 1099px) {
    .utility__note > span:last-child {
      display: none;
    }
  }

  @media (max-width: 859px) {
    .utility {
      display: none;
    }
  }

  /* ---------- Masthead ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(250 246 240 / 88%);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .site-header[data-scrolled] {
    border-bottom-color: var(--line);
    box-shadow: 0 10px 30px -24px rgb(15 27 45 / 40%);
  }

  .masthead {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--header-h);
  }

  .masthead__logo {
    display: inline-flex;
    text-decoration: none;
    border-radius: 12px;
  }

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .masthead__call span {
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Desktop nav ---------- */
  .nav {
    margin-left: 12px;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0;
    list-style: none;
  }

  .nav__item {
    position: static;
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.97rem;
    font-weight: 560;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }

  .nav__link:hover,
  .nav__trigger[aria-expanded='true'] {
    background: rgb(15 27 45 / 6%);
  }

  .nav__link[aria-current]::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 5px;
    height: 2px;
    border-radius: 2px;
    background: var(--copper-500);
  }

  .nav__trigger[aria-current]::after {
    right: 34px;
  }

  .nav__trigger :global(svg) {
    transition: transform 0.2s var(--ease);
  }

  .nav__trigger[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  /* ---------- Mega menu ---------- */
  .mega {
    position: absolute;
    left: 50%;
    top: calc(100% + 1px);
    width: min(100vw - 2 * var(--gutter), var(--container));
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 24px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-lg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mega:not([hidden]) {
      animation: mega-in 0.22s var(--ease-out);
    }
  }

  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translate(-50%, -6px);
    }
  }

  .mega__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .mega__card {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 14px 14px 18px;
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: background-color 0.15s var(--ease);
  }

  .mega__card:hover,
  .mega__card[aria-current] {
    background: var(--paper);
  }

  .mega__art {
    display: grid;
    place-items: center;
    height: 108px;
    margin-bottom: 10px;
    border-radius: var(--radius-sm);
    background: var(--paper-2);
  }

  .mega__art :global(svg) {
    height: 84px;
    width: auto;
  }

  .mega__title {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 620;
    color: var(--ink-900);
  }

  .mega__blurb {
    font-size: 0.88rem;
    color: var(--text-3);
    line-height: 1.4;
  }

  .mega__aside {
    display: grid;
    align-content: center;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--copper-50);
    font-size: 0.95rem;
    color: var(--text-2);
  }

  .mega__kicker {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 620;
    color: var(--ink-900);
    line-height: 1.15;
  }

  /* ---------- Mobile ---------- */
  .menu-btn {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -8px;
    border-radius: 14px;
    color: var(--ink-900);
  }

  .menu-btn:hover {
    background: rgb(15 27 45 / 6%);
  }

  @media (max-width: 1239px) {
    .masthead__ask {
      display: none;
    }
  }

  @media (max-width: 1059px) {
    .nav,
    .masthead__call {
      display: none;
    }

    .menu-btn {
      display: grid;
    }
  }

  /* ---------- Drawer ---------- */
  .drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 480px;
    height: 100%;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--text);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .drawer::backdrop {
    background: rgb(9 18 31 / 55%);
    backdrop-filter: blur(3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] {
      animation: drawer-in 0.32s var(--ease-out);
    }
  }

  @keyframes drawer-in {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
  }

  .drawer__top {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding: 0 var(--gutter);
    background: rgb(250 246 240 / 94%);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .drawer__top a {
    text-decoration: none;
  }

  .drawer__close {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -8px;
    border-radius: 14px;
  }

  .drawer__body {
    padding: 20px var(--gutter) calc(32px + env(safe-area-inset-bottom));
  }

  .drawer__label {
    margin: 8px 0 12px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .drawer__depts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .drawer__depts a {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 12px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    font-weight: 620;
    font-size: 0.95rem;
    line-height: 1.25;
    color: var(--ink-900);
    text-decoration: none;
  }

  .drawer__depts a[aria-current] {
    border-color: var(--copper-400);
  }

  .drawer__art {
    display: grid;
    place-items: center;
    height: 76px;
    border-radius: var(--radius-sm);
    background: var(--paper-2);
  }

  .drawer__art :global(svg) {
    height: 58px;
    width: auto;
  }

  .drawer__links {
    margin: 18px 0 26px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .drawer__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ink-900);
    text-decoration: none;
  }

  .drawer__links a[aria-current] {
    color: var(--copper-600);
  }

  .drawer__links :global(svg) {
    color: var(--copper-600);
  }

  .drawer__stores {
    display: grid;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .drawer__store {
    display: grid;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
  }

  .drawer__store > div:first-child {
    display: grid;
    gap: 8px;
    justify-items: start;
  }

  .drawer__store-name {
    font-weight: 680;
    color: var(--ink-900);
    text-decoration: none;
  }

  .drawer__store-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .drawer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-top: 22px;
  }

  .drawer__social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--text-2);
    text-decoration: none;
  }
</style>

<script>
  /* Sticky header shadow */
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => header.toggleAttribute('data-scrolled', !entry.isIntersecting), {
      rootMargin: '60px 0px 0px 0px',
    }).observe(sentinel);
  }

  /* Shop mega menu: click, keyboard and (for mice) hover */
  const shop = document.querySelector<HTMLElement>('[data-shop]');
  const trigger = shop?.querySelector<HTMLButtonElement>('.nav__trigger');
  const panel = shop?.querySelector<HTMLElement>('.mega');
  if (shop && trigger && panel) {
    let hoverTimer: number | undefined;
    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    trigger.addEventListener('click', () => setOpen(!isOpen()));
    shop.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        trigger.focus();
      }
    });
    shop.addEventListener('focusout', (e) => {
      if (!shop.contains(e.relatedTarget as Node | null)) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !shop.contains(e.target as Node)) setOpen(false);
    });

    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    shop.addEventListener('pointerenter', () => {
      if (!fine.matches) return;
      clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setOpen(true), 90);
    });
    shop.addEventListener('pointerleave', () => {
      if (!fine.matches) return;
      clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setOpen(false), 180);
    });
  }

  /* Mobile drawer */
  const drawer = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  if (drawer) {
    document.querySelectorAll('[data-menu-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        drawer.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );
    drawer.querySelector('[data-menu-close]')?.addEventListener('click', () => drawer.close());
    drawer.addEventListener('close', () => (document.documentElement.style.overflow = ''));
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.close();
      // Same-page anchors should close the menu too.
      if ((e.target as HTMLElement).closest('a[href*="#"]')) drawer.close();
    });
  }
</script>
