---
/* The Plug-ins box truck, on its way. */
import { mainStore } from '../../data/business';

const ink = 'var(--ink-900)';
---

<svg class="delivery-art" viewBox="0 0 360 220" role="img" aria-labelledby="delivery-art-title" focusable="false">
  <title id="delivery-art-title">Illustration of a Plug-ins delivery truck on the road.</title>
  <!-- Road -->
  <path d="M0 194h360" stroke={ink} stroke-width="3" stroke-linecap="round"></path>
  <path class="road" d="M8 208h34M78 208h34M148 208h34M218 208h34M288 208h34" stroke="var(--line-2)" stroke-width="4" stroke-linecap="round"></path>
  <!-- Speed lines -->
  <g class="speed" stroke="var(--copper-400)" stroke-width="4" stroke-linecap="round">
    <path d="M6 92h24M0 118h18M10 144h22"></path>
  </g>

  <g class="truck">
    <ellipse cx="180" cy="194" rx="150" ry="5" fill="rgb(15 27 45 / 12%)"></ellipse>
    <g stroke={ink} stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
      <rect x="42" y="46" width="188" height="124" rx="10" fill="#fffaf3"></rect>
      <path d="M230 80h50c9 0 15 4 20 11l20 28c4 6 6 12 6 19v32h-96z" fill="var(--copper-500)"></path>
      <path d="M242 90h35c5 0 9 2 12 6l15 22h-62z" fill="var(--glass)"></path>
      <path d="M236 132v34" fill="none"></path>
      <rect x="40" y="162" width="292" height="12" rx="5" fill="var(--ink-800)"></rect>
    </g>
    <rect x="42" y="136" width="188" height="12" fill="var(--copper-500)"></rect>
    <path d="M42 136h188M42 148h188" stroke={ink} stroke-width="3"></path>
    <path d="M250 96l-6 14" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity="0.45"></path>
    <rect x="248" y="140" width="14" height="4" rx="2" fill={ink}></rect>
    <circle cx="322" cy="146" r="5" fill="var(--volt)" stroke={ink} stroke-width="2.4"></circle>

    <!-- Logo on the box -->
    <g transform="translate(62 70)">
      <rect x="0" y="0" width="34" height="34" rx="10" fill="var(--copper-600)"></rect>
      <rect x="9.6" y="8.2" width="3.6" height="9" rx="1.8" fill="#fff8f1"></rect>
      <rect x="20.8" y="8.2" width="3.6" height="9" rx="1.8" fill="#fff8f1"></rect>
      <path d="M14.6 26.4v-2.2a2.4 2.4 0 0 1 4.8 0v2.2z" fill="#fff8f1"></path>
    </g>
    <text x="105" y="96" fill={ink} font-family="var(--font-display)" font-weight="700" font-size="28" letter-spacing="-0.8">Plug-ins</text>
    <text x="64" y="126" fill="var(--text-2)" font-family="var(--font-body)" font-weight="700" font-size="13" letter-spacing="0.4">{mainStore.phone}</text>

    <!-- Wheels -->
    <g class="wheel" stroke={ink} stroke-width="3">
      <circle cx="96" cy="176" r="20" fill="var(--ink-800)"></circle>
      <circle cx="96" cy="176" r="8" fill="var(--steel-300)"></circle>
    </g>
    <g class="wheel" stroke={ink} stroke-width="3">
      <circle cx="282" cy="176" r="20" fill="var(--ink-800)"></circle>
      <circle cx="282" cy="176" r="8" fill="var(--steel-300)"></circle>
    </g>
  </g>
</svg>

<style>
  .delivery-art {
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .truck {
      animation: bump 0.9s ease-in-out infinite;
    }

    .speed path {
      animation: speed 1.2s linear infinite;
    }

    .road {
      animation: road 0.9s linear infinite;
    }
  }

  @keyframes bump {
    50% {
      transform: translateY(-1.5px);
    }
  }

  @keyframes speed {
    0% {
      opacity: 0;
      transform: translateX(14px);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(-10px);
    }
  }

  @keyframes road {
    to {
      transform: translateX(-70px);
    }
  }
</style>
