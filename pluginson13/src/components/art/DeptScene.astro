---
/*
 * A few department drawings standing side by side on one floor line, for
 * the inner-page heroes. Everything is laid out inside a single SVG, so the
 * group always scales as one piece and never overflows its panel.
 */
import DeptArt from './DeptArt.astro';
import { artSize, type ArtKind } from './artSizes';

interface Props {
  /** `height` is relative: 100 = as tall as the scene. */
  items: { kind: ArtKind; height: number }[];
}

const { items } = Astro.props;

const H = 200;
const GAP = 12;
let x = 0;
const placed = items.map((item) => {
  const [vw, vh] = artSize[item.kind];
  const height = (item.height / 100) * H;
  const width = (vw / vh) * height;
  const place = { x, y: H - height, width, height };
  x += width + GAP;
  return { kind: item.kind, place };
});
const totalWidth = x - GAP;
---

<svg class="dept-scene" viewBox={`0 0 ${totalWidth} ${H}`} aria-hidden="true" focusable="false">
  {placed.map((item) => <DeptArt kind={item.kind} place={item.place} />)}
</svg>

<style>
  .dept-scene {
    width: 100%;
    height: 100%;
  }
</style>
