---
/* For the 404 page: the plug has come out of the wall. */
const ink = 'var(--ink-900)';
---

<svg class="unplugged-art" viewBox="0 0 340 220" aria-hidden="true" focusable="false">
  <!-- Wall & floor -->
  <path d="M0 176h340" stroke={ink} stroke-width="3" stroke-linecap="round"></path>

  <!-- Outlet plate with a surprised face -->
  <g stroke={ink} stroke-width="3" stroke-linejoin="round">
    <rect x="232" y="36" width="72" height="104" rx="14" fill="#fffdf9"></rect>
    <rect x="246" y="52" width="44" height="72" rx="10" fill="var(--paper-2)"></rect>
  </g>
  <g fill={ink}>
    <rect x="256" y="66" width="6" height="18" rx="3"></rect>
    <rect x="274" y="66" width="6" height="18" rx="3"></rect>
    <ellipse cx="268" cy="104" rx="6" ry="7"></ellipse>
  </g>

  <!-- Cord from off-screen, ending in the loose plug -->
  <path d="M-6 150c40 0 60 20 100 20s62-10 84-26" fill="none" stroke={ink} stroke-width="5" stroke-linecap="round"></path>
  <g transform="rotate(-24 196 130)">
    <g stroke={ink} stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
      <path d="M204 120v-14M216 120v-14" stroke-width="4"></path>
      <rect x="196" y="120" width="28" height="30" rx="7" fill="var(--copper-500)"></rect>
    </g>
    <rect x="201" y="125" width="5" height="14" rx="2.5" fill="#fff" opacity="0.5"></rect>
  </g>

  <!-- Little sparks of dismay -->
  <g class="fizzle" fill="none" stroke="var(--copper-500)" stroke-width="3.4" stroke-linecap="round">
    <path d="M226 78l-12-6M222 96l-14 2M228 60l-8-10"></path>
  </g>
</svg>

<style>
  .unplugged-art {
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fizzle {
      animation: fizzle 1.8s ease-in-out infinite;
    }
  }

  @keyframes fizzle {
    50% {
      opacity: 0.2;
    }
  }
</style>
