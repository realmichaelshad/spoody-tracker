---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StatusPill from '../components/StatusPill.astro';
import Marquee from '../components/Marquee.astro';
import StoreCard from '../components/StoreCard.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import BrandWall from '../components/BrandWall.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import KallahPreview from '../components/KallahPreview.astro';
import HeroScene from '../components/art/HeroScene.astro';
import MikvahArt from '../components/art/MikvahArt.astro';
import DeptArt from '../components/art/DeptArt.astro';
import { business, mainStore, stores, telHref } from '../data/business';
import { departments } from '../data/nav';
import { homeFaqs } from '../data/faq';
import { faqSchema, storeSchema } from '../lib/schema';
---

<Base
  rawTitle
  title="Plug-ins — Appliances, Kitchenware & Electronics in Brooklyn"
  description="Family-owned appliance, kitchenware & electronics store on 13th Ave, Boro Park and Spencer St, Williamsburg. Kallah showroom, keilim mikvah, fast delivery."
  schema={[...stores.map(storeSchema), faqSchema(homeFaqs)]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Boro Park · Williamsburg</p>
        <h1>Everything your home <em>runs on.</em></h1>
        <p class="lead">
          Refrigerators to urns, pots to shavers — appliances, kitchenware and electronics from the names you trust,
          with fast local delivery, flexible financing, and a keilim mikvah right in our 13th Avenue store.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={telHref(mainStore)} data-sheet-open="call">
            <Icon name="phone" /> Call the store
          </a>
          <a class="btn btn--ghost" href="#departments">
            Shop departments <Icon name="arrow" />
          </a>
        </div>
        <ul class="hero__stores" aria-label="Store status">
          {
            stores.map((store) => (
              <li>
                <a href={`/locations/${store.id}/`}>
                  <strong>{store.name}</strong>
                  <span>{store.street}</span>
                </a>
                <StatusPill store={store.id} />
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hero__art">
        <HeroScene />
      </div>
    </div>
  </section>

  <Marquee />

  <!-- Departments -->
  <section class="section" id="departments">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow">Shop by department</p>
          <h2>Four departments. <em>One stop.</em></h2>
        </div>
        <p class="lead">
          Browse the floor or call ahead — we'll tell you what's in stock, what it costs today, and when we can have it at
          your door.
        </p>
      </div>
      <ul class="depts">
        {
          departments.map((dept, i) => (
            <li class="reveal" style={`--delay:${i * 70}ms`}>
              <a class="dept" href={dept.href}>
                <span class="dept__art">
                  <DeptArt kind={dept.art} />
                </span>
                <span class="dept__body">
                  <h3>{dept.title}</h3>
                  <span class="dept__blurb">{dept.blurb}</span>
                  <span class="link-arrow">
                    Explore <Icon name="arrow" />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Kallah -->
  <section class="section section--ink kallah-feature" aria-labelledby="kallah-title">
    <div class="container kallah-feature__grid">
      <div class="stack reveal" style="--stack: 1.2rem">
        <p class="eyebrow">The kallah showroom</p>
        <h2 id="kallah-title">Mazel tov! Let's set up <em>the new home.</em></h2>
        <p class="lead">
          Our 13th Avenue showroom is made for kallahs and their families — appliances, pots, dishes, the urn and the
          plata, all under one roof, with people who know exactly what a new home needs.
        </p>
        <ul class="tick-list">
          <li>Build your list online, then walk the showroom with it</li>
          <li>Gift registries for the vort, the wedding and every simcha</li>
          <li>Tovel on site, and schedule delivery for move-in day</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href="/kallah/#kallah-list">
            <Icon name="list" /> Start our kallah list
          </a>
          <a class="btn btn--outline-light" href="/kallah/">About the showroom</a>
        </div>
      </div>
      <div class="reveal" style="--delay: 120ms">
        <KallahPreview />
      </div>
    </div>
  </section>

  <!-- Keilim mikvah -->
  <section class="section mikvah-feature" aria-labelledby="mikvah-title">
    <div class="container mikvah-feature__grid">
      <div class="mikvah-feature__art reveal">
        <MikvahArt />
      </div>
      <div class="stack reveal" style="--stack: 1.2rem; --delay: 100ms">
        <p class="eyebrow">Only at 13th Avenue</p>
        <h2 id="mikvah-title">Buy it. Tovel it. <em>Bring it home.</em></h2>
        <p class="lead">
          There's a keilim mikvah right inside our Boro Park store. An attendant unwraps your new pots, dishes and
          utensils, and rewraps them after tevilah — so everything goes home ready for the kitchen.
        </p>
        <ol class="steps">
          <li><span>1</span>Pick out your keilim</li>
          <li><span>2</span>We unwrap them for you</li>
          <li><span>3</span>You tovel</li>
          <li><span>4</span>We rewrap — done</li>
        </ol>
        <a class="link-arrow" href="/keilim-mikvah/">How the keilim mikvah works <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--sand" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow">More than a store</p>
          <h2 id="services-title">We don't stop at <em>the register.</em></h2>
        </div>
        <p class="lead">
          Delivery, financing, rebates and a registry — the things that make buying a fridge (or forty pieces of
          cookware) easy.
        </p>
      </div>
      <ServicesGrid />
    </div>
  </section>

  <!-- Brands -->
  <section class="section" id="brands" aria-labelledby="brands-title">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Brands on our floor</p>
        <h2 id="brands-title">The names you <em>already trust.</em></h2>
        <p class="lead">Looking for a brand that isn't here? Ask — if it's made, we can usually get it.</p>
      </div>
      <BrandWall />
    </div>
  </section>

  <!-- Locations -->
  <section class="section section--white" id="visit" aria-labelledby="visit-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow">Visit us</p>
          <h2 id="visit-title">Two Brooklyn stores. <em>Come say hi.</em></h2>
        </div>
        <p class="lead">
          Both stores are open Sunday through Friday and closed Shabbos and Yom Tov. The badges update live, so you'll
          know before you head out.
        </p>
      </div>
      <div class="stores-grid">
        {stores.map((store) => <StoreCard store={store} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container faq-layout">
      <div class="stack faq-layout__intro">
        <p class="eyebrow">Good questions</p>
        <h2 id="faq-title">Before you <em>come in.</em></h2>
        <p class="muted">
          Anything else? Call {mainStore.phone} or <a href={`mailto:${business.email}`}>email us</a>.
        </p>
      </div>
      <FaqList items={homeFaqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: clamp(28px, 5vw, 64px) 0 clamp(40px, 6vw, 80px);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -30% -10% auto auto;
    width: 60vw;
    height: 60vw;
    max-width: 820px;
    max-height: 820px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(224 138 85 / 18%), rgb(224 138 85 / 0%) 65%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
  }

  @media (max-width: 959px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }

  .hero__copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .hero h1 {
    font-size: var(--step-5);
    line-height: 0.98;
    letter-spacing: -0.028em;
  }

  .hero h1 em {
    display: inline-block;
  }

  .hero .lead {
    max-width: 54ch;
  }

  @media (max-width: 559px) {
    .hero .btn-row {
      width: 100%;
    }

    .hero .btn-row .btn {
      flex: 1 1 100%;
    }
  }

  .hero__stores {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin-top: 6px;
    padding: 18px 0 0;
    list-style: none;
    border-top: 1px solid var(--line-2);
    width: 100%;
  }

  .hero__stores li {
    display: grid;
    gap: 8px;
    justify-items: start;
  }

  .hero__stores a {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--ink-900);
    text-decoration: none;
  }

  .hero__stores a span {
    color: var(--text-3);
    font-size: 0.92rem;
  }

  .hero__stores a:hover strong {
    text-decoration: underline;
  }

  .hero__art {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
    background: var(--paper-2);
  }

  /* ---------- Departments ---------- */
  .depts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1059px) {
    .depts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 559px) {
    .depts {
      grid-template-columns: 1fr;
    }
  }

  .dept {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    border-radius: var(--radius-lg);
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .dept:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--copper-200);
  }

  .dept__art {
    position: relative;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(circle at 50% 110%, rgb(255 255 255 / 70%), transparent 60%),
      var(--paper-2);
    border-bottom: 1px solid var(--line);
  }

  /* A fixed box inside the frame: the viewBox fits each drawing — tall
     fridge or wide pot — centered inside it at the same visual weight. */
  .dept__art :global(svg) {
    position: absolute;
    left: 18%;
    top: 15%;
    width: 64%;
    height: 71%;
    transition: transform 0.4s var(--ease-out);
  }

  .dept:hover .dept__art :global(svg) {
    transform: translateY(-4px) scale(1.04);
  }

  .dept__body {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px 22px 24px;
  }

  .dept h3 {
    font-size: 1.36rem;
  }

  .dept__blurb {
    color: var(--text-2);
    font-size: 0.97rem;
    line-height: 1.45;
  }

  .dept .link-arrow {
    margin-top: 6px;
  }

  @media (max-width: 559px) {
    .dept {
      grid-template-columns: 132px 1fr;
      grid-template-rows: auto;
    }

    .dept__art {
      aspect-ratio: auto;
      min-height: 124px;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }

    .dept__art :global(svg) {
      left: 14%;
      top: 16%;
      width: 72%;
      height: 68%;
    }

    .dept__body {
      padding: 18px;
    }
  }

  /* ---------- Kallah feature ---------- */
  .kallah-feature {
    overflow: hidden;
  }

  .kallah-feature::before {
    content: '';
    position: absolute;
    right: -200px;
    top: -200px;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(207 106 49 / 28%), rgb(207 106 49 / 0%) 65%);
    pointer-events: none;
  }

  .kallah-feature__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
  }

  @media (max-width: 959px) {
    .kallah-feature__grid {
      grid-template-columns: 1fr;
    }
  }

  .kallah-feature h2 {
    font-size: var(--step-4);
  }

  .kallah-feature .btn-row {
    margin-top: 8px;
  }

  /* ---------- Mikvah feature ---------- */
  .mikvah-feature__grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: clamp(36px, 6vw, 88px);
  }

  @media (max-width: 959px) {
    .mikvah-feature__grid {
      grid-template-columns: 1fr;
    }

    .mikvah-feature__art {
      order: 2;
    }
  }

  .mikvah-feature h2 {
    font-size: var(--step-4);
  }

  .mikvah-feature__art {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--card);
    border: 1px solid var(--line);
    font-weight: 560;
    font-size: 0.97rem;
    line-height: 1.3;
  }

  .steps span {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--water-100);
    color: #1f5f86;
    font-weight: 700;
    font-size: 0.9rem;
  }

  @media (max-width: 459px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Locations ---------- */
  .stores-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 859px) {
    .stores-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- FAQ ---------- */
  .faq-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 32px 72px;
    align-items: start;
  }

  @media (max-width: 859px) {
    .faq-layout {
      grid-template-columns: 1fr;
    }
  }

  .faq-layout__intro {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .faq-layout h2 {
    font-size: var(--step-4);
  }

  .faq-layout a {
    color: var(--copper-700);
  }
</style>
