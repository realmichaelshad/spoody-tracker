  },
  {
    id: 'garment-care',
    title: 'Irons & garment steamers',
    text: 'Steam irons and garment steamers to get the Shabbos clothes looking their best.',
    points: ['Steam irons', 'Garment steamers'],
  },
];

const tips: Tip[] = [
  {
    icon: 'bolt',
    title: 'Spread the load before Shabbos',
    text: 'An urn and a plata together can draw more power than one kitchen circuit handles. Plug them into outlets on different circuits so nothing trips in the middle of Shabbos.',
  },
  {
    icon: 'heart',
    title: 'One for milchig, one for fleishig',
    text: 'Plenty of families keep two of the everyday tools — a toaster, a hand blender, an extra mixer bowl. We’ll help you pick a matching pair.',
  },
  {
    icon: 'chat',
    title: 'Size the urn to the crowd',
    text: 'Tell us how many you usually host and we’ll suggest a size. A family Shabbos and a sheva brachos are very different jobs.',
  },
];
