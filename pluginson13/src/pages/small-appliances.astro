const categories: Category[] = [
  {
    id: 'shabbos',
    title: 'Urns, platas & Shabbos essentials',
    text: 'Hot water urns in every size, platas and warming trays, blechs and Shabbos timers — everything that keeps Shabbos warm.',
    points: ['Hot water urns', 'Platas & warming trays', 'Blechs', 'Shabbos timers'],
  },
  {
    id: 'mixers',
    title: 'Mixers & food processors',
    text: 'Stand mixers strong enough for a double batch of challah dough, plus food processors, hand mixers and immersion blenders.',
    points: ['Stand mixers', 'Food processors', 'Hand mixers', 'Immersion blenders'],
  },
  {
    id: 'slow-cookers',
    title: 'Slow cookers & multi-cookers',
    text: 'Slow cookers for cholent that’s ready when you are, and pressure cookers, multi-cookers and rice cookers for busy weeknights.',
    points: ['Slow cookers', 'Pressure & multi-cookers', 'Rice cookers'],
  },
  {
    id: 'coffee',
    title: 'Coffee, espresso & kettles',
    text: 'Drip coffee makers, espresso machines, grinders and electric kettles — for the morning coffee and the Shabbos tea.',
    points: ['Drip & pod', 'Espresso', 'Grinders', 'Electric kettles'],
  },
  {
    id: 'countertop',
    title: 'Toasters, ovens & air fryers',
    text: 'Toasters and toaster ovens (one milchig, one fleishig), air fryers, griddles and sandwich makers.',
    points: ['Toasters', 'Toaster ovens', 'Air fryers', 'Griddles'],
  },
  {
    id: 'blenders',
    title: 'Blenders & juicers',
    text: 'Full-size and personal blenders for shakes and soups, plus juicers for the fresh-squeezed crowd.',
    points: ['Countertop blenders', 'Personal blenders', 'Juicers'],
  },
  {
    id: 'vacuums',
    title: 'Vacuums & floor care',
    text: 'Canister and upright vacuums — including SEBO — stick vacuums and handhelds for the crumbs after every meal.',
    points: ['Canister & upright', 'Stick & handheld', 'SEBO'],
  },
  {
    id: 'comfort',
    title: 'Fans, heaters & air care',
    text: 'Fans for the summer, heaters for the winter, and air purifiers and humidifiers all year round.',
