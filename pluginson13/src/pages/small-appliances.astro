<Department
  path="/small-appliances/"
  metaTitle="Urns, Platas & Small Appliances in Brooklyn"
  description="Hot water urns, platas, Shabbos timers, stand mixers, slow cookers, coffee makers and vacuums at Plug-ins in Boro Park and Williamsburg."
  eyebrow="Small appliances"
  title="The small stuff that"
  em="runs the kitchen."
  lead="Urns and platas for Shabbos, mixers for challah, slow cookers for cholent and coffee for every morning in between — plus vacuums, fans and heaters for the rest of the house."
  art={[
    { kind: 'urn', height: 100 },
    { kind: 'mixer', height: 76 },
  ]}
  categoriesTitle="Countertop to closet,"
  categoriesEm="covered."
  categoriesLead="From the urn on the Shabbos table to the vacuum in the hall closet, here's what you'll find on our shelves."
  categories={categories}
  tipsTitle="A few things we tell everyone"
  tips={tips}
  faqs={[specialOrderFaq, mikvahFaq, registryFaq, hoursFaq]}
/>
